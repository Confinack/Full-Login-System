generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique
  password    String
  isVerified  Boolean     @default(false)
  otps        Otp[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Otp {
  id          String    @id @default(uuid())
  user_id     String
  code        Int
  expiryAt    DateTime
  user        User      @relation(fields: [user_id], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}