generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique
  password    String
  OTP_CODE    Int?
  OTP_EXPIRY  DateTime?    
  isVerified  Boolean     @default(false)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}